    "qe:guard:aq22": "node qe/cli.ts run --only aq22",
    "qe:guard:oracle": "node scripts/verify-rule-oracles.ts",
    "qe:guard:spec": "node qe/cli.ts run --only spec-abs",
    "qe:guard:waivers": "node scripts/verify-triage.ts",
    "qe:guard:mp01": "node qe/cli.ts run --only mp01",
    "qe:guard:mp02": "node qe/cli.ts run --only mp02",
    "qe:guard:mp03": "node qe/cli.ts run --only mp03",
    "qe:guard:mp04": "node qe/cli.ts run --only mp04",
    "qe:guard:mp05": "node qe/cli.ts run --only mp05",
    "qe:guard:mp06": "node qe/cli.ts run --only mp06",
    "qe:guard:mp07": "node qe/cli.ts run --only mp07",
    "qe:guard:mp08": "node qe/cli.ts run --only mp08",
    "qe:guard:leak": "node qe/cli.ts run --only leak",
    "qe:guard:iso01": "node qe/cli.ts run --only iso01",
    "qe:guard:isolation": "node scripts/verify-isolation.ts",
    "qe:skills": "node qe/cli.ts skills --check",
    "qe:ratchet": "node qe/cli.ts run",
    "qe:ratchet:update": "node qe/cli.ts ratchet-update",
    "qe:ci": "npm run typecheck && npm run test:invariants && npm run qe:skills && npm run test:triage && npm run test:isolation && npm run test:spec && npm run test:oracle && npm run test:idem-triage && npm run qe:report"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.0"
