    "qe:guard:inv24": "node qe/cli.ts run --only inv24",
    "qe:guard:inv25": "node qe/cli.ts run --only inv25",
    "qe:guard:inv26": "node qe/cli.ts run --only inv26",
    "qe:guard:inv27": "node qe/cli.ts run --only inv27",
    "qe:guard:inv28": "node qe/cli.ts run --only inv28",
    "qe:guard:aq01": "node qe/cli.ts run --only aq01",
    "qe:guard:aq02": "node qe/cli.ts run --only aq02",
    "qe:guard:aq03": "node qe/cli.ts run --only aq03",
