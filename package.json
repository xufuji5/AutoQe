{
  "name": "autoqe",
  "version": "1.0.0",
  "type": "module",
  "description": "AutoQe — Quality Engineering toolkit for AI-assisted development: invariant registry, static guards, bad-sample self-tests and a ratchet baseline.",
  "license": "MIT",
  "bin": {
    "autoqe": "dist/cli.js"
  },
  "files": [
    "dist",
    "qe/templates",
    "qe/rules",
    "qe/skills",
    "qe/registry",
    "qe.config.miniprogram.json",
    "QE-*.md",
    "AGENTS.md",
    "tsconfig.qe.json",
    "docs/ai-agent-workflow.md",
    "docs/configuration.md"
  ],
  "keywords": [
    "quality-engineering",
    "static-analysis",
    "invariants",
    "ai-coding",
    "prisma",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufuji5/AutoQe.git"
  },
  "bugs": {
    "url": "https://github.com/xufuji5/AutoQe/issues"
  },
  "homepage": "https://github.com/xufuji5/AutoQe#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.qe.json",
    "qe": "node qe/cli.ts run",
    "qe:init": "node qe/cli.ts init",
    "qe:list": "node qe/cli.ts list",
    "qe:status": "node qe/cli.ts status",
    "qe:triage": "node qe/cli.ts triage",
    "qe:selftest": "node qe/cli.ts selftest",
    "qe:report": "node qe/cli.ts report",
    "test:invariants": "node qe/cli.ts run",
    "test:triage": "node scripts/verify-triage.ts",
    "test:isolation": "node scripts/verify-isolation.ts",
    "test:spec": "node scripts/verify-spec-tables.ts",
    "test:oracle": "node scripts/verify-rule-oracles.ts",
    "test:idem-triage": "node scripts/verify-idem-triage.ts",
    "test:invariants-selftest": "node qe/cli.ts selftest",
    "qe:guard:inv01": "node qe/cli.ts run --only inv01",
    "qe:guard:inv02": "node qe/cli.ts run --only inv02",
    "qe:guard:inv03": "node qe/cli.ts run --only inv03",
    "qe:guard:inv06": "node qe/cli.ts run --only inv06",
    "qe:guard:inv07": "node qe/cli.ts run --only inv07",
    "qe:guard:inv13": "node qe/cli.ts run --only inv13",
