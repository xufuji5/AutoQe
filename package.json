    "qe:guard:aq07": "node qe/cli.ts run --only aq07",
    "qe:guard:aq08": "node qe/cli.ts run --only aq08",
    "qe:guard:aq09": "node qe/cli.ts run --only aq09",
    "qe:guard:aq10": "node qe/cli.ts run --only aq10",
    "qe:guard:aq11": "node qe/cli.ts run --only aq11",
    "qe:guard:aq12": "node qe/cli.ts run --only aq12",
    "qe:guard:aq13": "node qe/cli.ts run --only aq13",
    "qe:guard:aq14": "node qe/cli.ts run --only aq14",
    "qe:guard:aq16": "node qe/cli.ts run --only aq16",
